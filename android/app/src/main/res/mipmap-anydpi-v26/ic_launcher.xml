<?xml version="1.0" encoding="utf-8"?>
<!-- Icône adaptative (Android 8+) : le lanceur applique lui-même sa forme
     (ronde, carrée arrondie, goutte) sur ces deux couches. Le dessin occupe
     58 % du canevas, donc il reste entier quelle que soit la découpe. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <!-- Android 13+ : icône teintée par le fond d'écran de l'utilisateur. -->
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
