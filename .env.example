# Modele de configuration. Copier en .env et y mettre les vraies valeurs.
# Le .env n'est jamais commite : le depot est public.
#
# DEVELOPPEMENT UNIQUEMENT. Un .env declare dans les assets est embarque
# dans l'APK et s'en extrait en clair. Avant de diffuser un APK, jury
# compris, basculer sur Firebase AI Logic ou la cle reste cote serveur.

# Cle fournie par Rodium AI
RODIUM_API_KEY=

# Racine de l'API, sans slash final
RODIUM_BASE_URL=https://api.rodiumai.io/v1

# Modele multimodal. Gemini plutot que Claude : c'est la famille servie
# par Firebase AI Logic, donc le prompt restera valable apres la bascule.
RODIUM_MODEL=google/gemini-3.8-flash
